{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Pi Agent Runtime \u2014 Event Loop",
    "output": "pi-agent-runtime.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "session-lifecycle",
        "label": "Session lifecycle",
        "focus": [
          "pi-start",
          "pi-input",
          "pi-end"
        ],
        "note": "session_start fires once at session init; session_shutdown at quit."
      },
      {
        "id": "tool-exec",
        "label": "Tool execution (when LLM emits tool_call)",
        "focus": [
          "pi-before",
          "llm-call"
        ],
        "note": "tool_call fires event to ext; ext can block. Then pi dispatches to tool runtime and feeds result back to LLM as a new message."
      }
    ]
  },
  "lanes": [
    {
      "id": "pi",
      "label": "Pi Core"
    },
    {
      "id": "llm",
      "label": "LLM"
    }
  ],
  "phases": [
    {
      "id": "init",
      "label": "Session init",
      "fromCol": 0,
      "toCol": 0,
      "variant": "emphasis"
    },
    {
      "id": "input",
      "label": "User input",
      "fromCol": 1,
      "toCol": 1
    },
    {
      "id": "turn",
      "label": "Agent + LLM call",
      "fromCol": 2,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "end",
      "label": "Turn end / session end",
      "fromCol": 3,
      "toCol": 3,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "pi-start",
    "pi-input",
    "pi-before",
    "pi-end"
  ],
  "nodes": [
    {
      "id": "pi-start",
      "lane": "pi",
      "col": 0,
      "type": "cloud",
      "label": "session_start",
      "tag": "once",
      "width": 108
    },
    {
      "id": "pi-input",
      "lane": "pi",
      "col": 1,
      "type": "backend",
      "label": "input event",
      "tag": "per user message",
      "width": 108
    },
    {
      "id": "pi-before",
      "lane": "pi",
      "col": 2,
      "type": "backend",
      "label": "before_agent",
      "tag": "per turn",
      "width": 108
    },
    {
      "id": "llm-call",
      "lane": "llm",
      "col": 2,
      "type": "cloud",
      "label": "LLM stream",
      "tag": "before_provider_request",
      "width": 108
    },
    {
      "id": "pi-end",
      "lane": "pi",
      "col": 3,
      "type": "backend",
      "label": "turn_end",
      "tag": "end-of-turn",
      "width": 108
    }
  ],
  "edges": [
    {
      "id": "start-input",
      "from": "pi-start",
      "to": "pi-input",
      "label": "session ready",
      "variant": "emphasis"
    },
    {
      "id": "input-before",
      "from": "pi-input",
      "to": "pi-before",
      "label": "agent_start + turn_start",
      "variant": "emphasis"
    },
    {
      "id": "before-llm",
      "from": "pi-before",
      "to": "llm-call",
      "label": "messages",
      "variant": "emphasis"
    },
    {
      "id": "llm-before",
      "from": "llm-call",
      "to": "pi-before",
      "label": "stream: message_start -> update -> end / tool_call",
      "variant": "emphasis"
    },
    {
      "id": "before-end",
      "from": "pi-before",
      "to": "pi-end",
      "label": "turn_end + agent_end",
      "variant": "emphasis"
    },
    {
      "id": "input-direct",
      "from": "pi-input",
      "to": "pi-before",
      "label": "input handled -> turn_start",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Per-turn loop (the runtime)",
      "items": [
        "input -> input handler -> (per turn) before_agent_start",
        "before_agent_start -> LLM stream call -> process response",
        "process response -> (if tool_call) tool exec loop, else turn_end",
        "turn_end -> next turn or session_shutdown at quit"
      ]
    },
    {
      "dot": "rose",
      "title": "Extension events fired between these nodes",
      "items": [
        "pi-input -> input event (extensions transform text)",
        "  -> Pt intercepts /name, findFlow + bindFlowTemplate",
        "pi-before -> before_agent_start (extensions rewrite prompt)",
        "  -> Pt injects cachedSegment into systemPrompt",
        "llm-call -> before_provider_request, before_provider_headers",
        "  -> message_start/update/end, tool_call/result, turn_end",
        "session_start / session_shutdown at pi-start / pi-end"
      ]
    }
  ]
}