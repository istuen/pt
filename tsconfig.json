{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "schema.ts",
    "frontend/**/*.ts",
    "midend/**/*.ts",
    "backend/**/*.ts",
    "transpile.ts"
  ],
  "exclude": ["node_modules"]
}
