{
  "name": "@issac/pi-pt",
  "version": "0.1.0",
  "description": "Pt — Turn domain knowledge into configurable Agent Context.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "verify": "biome check && vitest run tests/verify/",
    "verify:phase9": "vitest run tests/verify/phase9.test.ts",
    "verify:flows": "vitest run tests/verify/flows.test.ts",
    "prebuild": "tsc --noEmit && biome check",
    "build": "tsup",
    "prepublishOnly": "npm run build && npm run verify"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
