{
  "name": "@issac/pi-pt",
  "version": "0.1.0",
  "description": "Pt (Polyglot Transpiler) — Pi extension that transpiles multi-source business knowledge (MD Assets) into Pi systemPrompt",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "tsx tests/verify/verify-phase9.ts && tsx tests/verify/verify-flows.ts",
    "verify:phase9": "tsx tests/verify/verify-phase9.ts",
    "verify:flows": "tsx tests/verify/verify-flows.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
