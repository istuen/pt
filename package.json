{
  "name": "@issac/pi-pt",
  "version": "0.1.0",
  "description": "Pt (Polyglot Transpiler) — Pi extension that transpiles multi-source business knowledge (MD Assets) into Pi systemPrompt",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "verify": "vitest run tests/verify/",
    "verify:phase9": "vitest run tests/verify/phase9.test.ts",
    "verify:flows": "vitest run tests/verify/flows.test.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
